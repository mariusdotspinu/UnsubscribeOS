<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.unsubscribeos.ui.component.Toast"
      fx:id="container" styleClass="toast" spacing="8" maxWidth="560"
      visible="false" managed="false" onMouseClicked="#hide">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="icon" styleClass="toast-icon"/>
        <Label fx:id="message" styleClass="toast-message" wrapText="true" HBox.hgrow="ALWAYS"/>
    </HBox>
    <ProgressBar fx:id="timer" styleClass="toast-progress" progress="1" maxWidth="Infinity"/>
</VBox>
