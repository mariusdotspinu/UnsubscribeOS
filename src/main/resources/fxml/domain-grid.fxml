<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- The list of sender cards; shows `message` instead while there is nothing to list. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.unsubscribeos.ui.view.dashboard.DomainGrid"
      fx:id="list" spacing="12">
    <fx:define>
        <Label fx:id="message" styleClass="muted"/>
    </fx:define>
</VBox>
