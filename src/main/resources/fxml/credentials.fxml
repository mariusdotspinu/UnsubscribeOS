<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.unsubscribeos.ui.view.CredentialsView"
            styleClass="root">
    <padding><Insets topRightBottomLeft="20"/></padding>

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="←  Back" styleClass="ghost" onAction="#back"/>
            <Region HBox.hgrow="ALWAYS"/>
            <fx:include source="theme-toggle.fxml"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <VBox spacing="14" maxWidth="560" alignment="CENTER_LEFT">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane fx:id="logo"/>
                    <Label fx:id="heading" styleClass="section"/>
                </HBox>
                <TitledPane text="How do I get my credentials?" expanded="false">
                    <fx:include fx:id="help" source="tutorial.fxml"/>
                </TitledPane>
                <VBox spacing="6">
                    <Label text="Client ID" styleClass="muted"/>
                    <TextField fx:id="clientId" promptText="Client ID"/>
                </VBox>
                <VBox fx:id="secretField" spacing="6">
                    <Label text="Client secret" styleClass="muted"/>
                    <PasswordField fx:id="clientSecret" promptText="Client secret"/>
                </VBox>
                <CheckBox fx:id="remember" text="Remember me"/>
                <Button fx:id="signIn" styleClass="primary" onAction="#signIn"/>
                <Label fx:id="status" styleClass="muted"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
