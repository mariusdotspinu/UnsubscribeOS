@startuml architecture
title UnsubscribeOS — architecture (ui → core → config)
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

package "ui  (JavaFX)" {
  component Launcher
  component Router
  component ProviderView
  component CredentialsView
  component DashboardView
  component DomainCard
  component "AppContext (DI record)" as AppContext
  component "component/* — Toast, Modal,\nProviderLogo, ThemeToggle,\nTutorial, HeatScale" as UIComponents
  component "resources/fxml/*.fxml\n(layout; Java classes are controllers)" as Fxml
}

package "core  (no JavaFX)" {
  component AuthService
  component AccountStore
  component Aes
  component Pkce
  component LoopbackOAuth
  component MailService <<abstract>>
  component GmailService
  component OutlookService
  component UnsubscribeService
  component Http
  component Browser
}

package "config" {
  component AppPaths
  component Settings
}

Launcher --> Router
Router --> ProviderView
Router --> CredentialsView
Router --> DashboardView
DashboardView --> DomainCard
ProviderView ..> Fxml : layout
CredentialsView ..> Fxml : layout
DashboardView ..> Fxml : layout

AuthService --> AccountStore
AuthService --> LoopbackOAuth
LoopbackOAuth --> Pkce
AccountStore --> Aes
GmailService --|> MailService
OutlookService --|> MailService
GmailService --> Http
OutlookService --> Http
UnsubscribeService --> Http
UnsubscribeService --> Browser

DashboardView --> MailService
CredentialsView --> AuthService
DashboardView --> UnsubscribeService
AccountStore --> AppPaths
@enduml
